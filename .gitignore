# Root Git Ignore for DocuMind AI

# Node / Frontend
**/node_modules/
**/dist/
**/.angular/

# Java / Maven / Backend
**/target/
**/.mvn/wrapper/maven-wrapper.jar

# IDE & OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Sensitive Environment and local config files
*.env
.env
.env.*
!.env.example
application-local.yml
*-local.yml
